# Single list of environment variables (VII §36.7). Functional settings live in config/pipeline.yaml or Setting,
# never here; secrets live here, never anywhere else. Copy to .env (never committed) and fill in.

# ── Required ─────────────────────────────────────────────────────────────────────────────────────────────────────────
# Contact included in the User-Agent. Missing → the worker refuses to start.
HTTP_CONTACT=https://github.com/qsjk/ai-tech-radar
# Public URL of the dashboard, no trailing slash, no port: address of the Caddy site, origin expected by the anti-CSRF
# check, links in the alerts.
DASHBOARD_URL=https://radar.example.com
DASHBOARD_USER=souhaib
# bcrypt hash (caddy hash-password). Single quotes are REQUIRED: the hash contains "$" that Compose would interpolate.
DASHBOARD_PASSWORD_HASH='$2a$14$...'

# ── Required by the GitHub sources (the only collection credential in V1) ────────────────────────────────────────────
# Missing → github sources are not scheduled, the worker starts anyway.
GITHUB_TOKEN=

# ── Required in production: backup (VII §38) ─────────────────────────────────────────────────────────────────────────
# Missing → backup "not_configured", degraded health.
# RESTIC_REPOSITORY, e.g. s3:https://<endpoint>/<bucket>/radar or sftp:user@host:/radar
RESTIC_REPOSITORY=
# RESTIC_PASSWORD: keep it ALSO outside the VPS (password manager).
RESTIC_PASSWORD=
# Credentials of the chosen restic backend (S3-compatible here).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Optional: LLM (without them, the product runs without LLM, at 0 €) ───────────────────────────────────────────────
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ── Optional: alert channels (a channel is disabled if incomplete) ───────────────────────────────────────────────────
# At least one channel is required to go to production (Part VIII).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Optional: technical ──────────────────────────────────────────────────────────────────────────────────────────────
# Let's Encrypt contact.
ACME_EMAIL=
# "development" enables /docs; "test" is reserved for tests; safe default = production.
APP_ENV=production
LOG_LEVEL=INFO
# Image tag (Git sha) deployed.
RADAR_VERSION=

# ── Reserved for tests (e2e override, never in production) ──────────────────────────────────────────────────────────
# Read only if APP_ENV=test; set with APP_ENV=production → the worker refuses to start (Part VIII decision 23,
# Part IV §21.1).
# HTTP_TEST_ALLOW_HOSTS=

# ── Reserved for V2 (not read in V1) ─────────────────────────────────────────────────────────────────────────────────
# REDDIT_CLIENT_ID= REDDIT_CLIENT_SECRET= YOUTUBE_API_KEY=
