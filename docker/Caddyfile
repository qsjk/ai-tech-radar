# Caddyfile (VII §37.3). Only entry point; /health is the only public route.
{
	# Quoted so that an empty ACME_EMAIL (optional, VII §36.7) yields an ACME account without contact, not a parse error.
	email "{$ACME_EMAIL}"
	# Never install the local CA (used for localhost in development) into the system trust store: the container's
	# root filesystem is read-only and Caddy only writes to /data, /config and /tmp (architecture.md §4.3).
	skip_install_trust
	# log_credentials is NOT enabled: Authorization and Cookie stay masked in the logs (VII §42.3).
}

# Security headers of every response, errors included (VII §37.3, T-SEC-06).
(security_headers) {
	header {
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		X-Content-Type-Options "nosniff"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}

{$DASHBOARD_URL} {
	encode zstd gzip

	log {
		output stdout
		format json
	}
	log_skip /health

	import security_headers

	# Error responses (the 401 of basic_auth among them) do not go through the site's header directive: same headers
	# here, and no Server header either (#98, #95). The error status is kept.
	handle_errors {
		import security_headers
	}

	# A body announced over 1 MB by Content-Length is refused with 413, before authentication and before the app (review
	# of #100, T-SEC-06): request_body max_size only applies to a body that is read. It is kept below for bodies that
	# are read, chunked ones included. The error goes through handle_errors, hence the security headers.
	@body_too_large expression `{http.request.header.Content-Length} != "" && int({http.request.header.Content-Length}) > 1048576`
	handle @body_too_large {
		error "request body too large" 413
	}

	# Public: minimal status only.
	handle /health {
		reverse_proxy app:8000
	}

	# Everything else: authenticated.
	handle {
		basic_auth {
			{$DASHBOARD_USER} {$DASHBOARD_PASSWORD_HASH}
		}

		handle /api/* {
			request_body {
				max_size 1MB
			}
			reverse_proxy app:8000
		}

		handle {
			root * /srv
			# route keeps this order: the index.html header is set after try_files has rewritten the SPA routes.
			route {
				try_files {path} /index.html
				@assets path /assets/*
				header @assets Cache-Control "public, max-age=31536000, immutable"
				header /index.html Cache-Control "no-cache"
				file_server
			}
		}
	}
}
