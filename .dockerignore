# Secrets: never in an image (VIII §46.2, VII §43.4)
.env
.env.*
!.env.example

# Repository, environments and local caches
.git/
.github/
.claude/
.venv/
**/__pycache__/
**/*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
dist/
build/
*.egg-info/
node_modules/
frontend/node_modules/
frontend/dist/

# Documentation and tests: kept out of the images
docs/
tests/
